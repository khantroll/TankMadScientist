{#
  Crew children partial — returned as the innerHTML of #crew-children-inner-{run_id}.

  This file is the ONLY thing that should ever schedule the next poll for
  crew children. The outer #crew-children-inner-{run_id} wrapper (in
  run_list.html) fires "load" once and nothing else — it lives inside
  #crew-children-{run_id}, which carries hx-preserve="true" on the parent
  run card, so its hx-trigger is frozen at whatever the run's status was on
  first render and never gets re-evaluated. Re-adding an "every 3s" there
  (as a previous version of this file did) creates a second, independent
  polling loop racing this one: overlapping innerHTML swaps on the same
  target intermittently clobber each other mid-swap, causing nested run
  output panels to blink in and out of the DOM. If you need polling to
  start/stop based on live status, this hidden trigger div is the only
  correct place to do it.

  For active crew runs it re-injects this same hidden polling trigger so
  the parent keeps refreshing every 3s. When the run finishes the trigger
  is omitted and polling stops organically.

  Child output slots use the canonical #run-output-{id} naming so toggleRunOutput(),
  scroll preservation, and auto-expand logic all work uniformly.
#}
{% if is_active %}
<div hx-get="{{ url_for('run_children', run_id=run_id) }}"
     hx-trigger="every 3s"
     hx-target="#crew-children-inner-{{ run_id }}"
     hx-swap="innerHTML settle:0"
     style="display:none"
     aria-hidden="true"></div>
{% endif %}

{% if children %}
<ul class="crew-child-list">
  {% for entry in children %}
  {% set child = entry.run %}
  {% set tools = entry.tools %}
  <li class="crew-child-run" id="crew-child-{{ child.id }}">

    {# Compact single-row child head — click toggles output #}
    <div class="crew-child-head run-head--toggle"
         onclick="toggleRunOutput({{ child.id }})">

      <div class="run-head-left">
        <span class="crew-step-num">{{ loop.index }}</span>
        <span class="status-dot status-dot--{{ child.status }}"></span>
        <span class="status-label status-label--{{ child.status }}">
          {{- child.status | replace('awaiting_approval', 'approval') | replace('_', ' ') -}}
        </span>
        {% if child.provider %}
          <span class="mono rh-dim rh-provider">{{ child.provider }}</span>
        {% endif %}
        {% for tool in tools %}
          <span class="tool-badge">{{ tool }}</span>
        {% endfor %}
      </div>

      <div class="run-head-task-wrap">
        <span class="run-task--compact">{{ child.task }}</span>
      </div>

      <div class="run-head-right">
        {% if child.status == 'awaiting_approval' %}
        <button type="button" class="btn btn-approve btn-xs"
                onclick="event.stopPropagation()"
                hx-post="{{ url_for('approve_run_patch', run_id=child.id) }}"
                hx-target="#run-output-{{ child.id }}"
                hx-swap="innerHTML">
          ✓ Approve
        </button>
        {% endif %}
        {% if child.status in ('running', 'awaiting_approval', 'pending') %}
        <button type="button" class="btn btn-cancel btn-xs"
                onclick="event.stopPropagation()"
                hx-post="{{ url_for('cancel_run_route', run_id=child.id) }}"
                hx-target="#run-output-{{ child.id }}"
                hx-swap="innerHTML"
                hx-confirm="Cancel step {{ loop.index }}?">
          ×
        </button>
        {% endif %}
        <span class="output-chevron crew-chevron" id="output-chevron-{{ child.id }}">&#9654;</span>
      </div>

    </div>{# /.crew-child-head #}

    {#
      hx-preserve keeps any open output panel alive when the crew children list re-polls.
      ID matches the canonical #run-output-{id} so all JS helpers work without change.
    #}
    <div id="run-output-{{ child.id }}"
         class="run-output-slot"
         style="display:none"
         hx-preserve="true"
         {% if child.status in ('running', 'awaiting_approval', 'pending') %}
         hx-get="{{ url_for('run_output', run_id=child.id) }}"
         hx-trigger="every 2s" hx-target="#run-output-{{ child.id }}" hx-swap="innerHTML settle:0"
         {% endif %}>
    </div>

  </li>
  {% endfor %}
</ul>
{% else %}
<p class="crew-loading">Waiting for crew to start the first step…</p>
{% endif %}
